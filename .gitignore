# Результаты сборки — собираются локально из src/ одной командой
build/

# Резервные копии файлов игры (в том числе UI.zip ~1 ГБ)
backup/

# Шрифты в репозиторий не попадают: они берутся из вашей Windows во время установки,
# а растровые шрифты движка генерируются штатным MakeSpriteFont.exe из самой игры
*.ttf
*.otf
*.spritefont

# Oswald под лицензией OFL распространять можно — он идёт в комплекте
!src/fonts/*.ttf

node_modules/
*.log

# Готовые архивы релизов — выкладываются в GitHub Releases
dist/
